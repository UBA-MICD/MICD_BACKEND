# Env file for docker-compose.prod.yml — copy to .env, fill in every blank.
# Nothing here has an insecure default; docker-compose.prod.yml and env.ts
# both fail fast at startup if a required secret is left unset.
#
# Usage:
#   cp .env.prod.example .env
#   # fill in the values below, then:
#   docker compose -f docker-compose.prod.yml up -d --build

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=micd
DB_USER=micd
# Required. Generate with: openssl rand -hex 16
DB_PASSWORD=

# ── Orthanc DICOM server ──────────────────────────────────────────────────────
ORTHANC_USERNAME=orthanc
# Required. Generate with: openssl rand -hex 16
ORTHANC_PASSWORD=
# Only needed if an external DICOM modality C-STOREs directly into Orthanc
# (see the commented-out `ports:` block on the orthanc service).
ORTHANC_DICOM_PORT=4242

# ── Backend ───────────────────────────────────────────────────────────────────
# Host port the API is published on.
BACKEND_PORT=3000

# ── TLS ───────────────────────────────────────────────────────────────────────
# Set to exactly "true" to have the backend serve HTTPS directly. Leave false
# if a reverse proxy in front already terminates TLS.
TLS_ENABLED=false
# Paths as seen INSIDE the container — point them under /certs, which is
# bind-mounted from TLS_CERTS_DIR below. Required when TLS_ENABLED=true.
TLS_CERT_PATH=/certs/tls.crt
TLS_KEY_PATH=/certs/tls.key
# Host directory containing the cert/key files referenced above.
TLS_CERTS_DIR=./certs

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost factor for password hashing (12 = OWASP-recommended minimum)
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@micd.local
# Required. Generate with: openssl rand -base64 18
ADMIN_PASSWORD=
# Optional display name for the seeded admin (defaults to "Administrador").
ADMIN_NAME=

# ── Invites / email (US-H04) ────────────────────────────────────────────────────
# Public base URL of the web app; the invite link is APP_BASE_URL/?invite=<code>.
APP_BASE_URL=
# SMTP for invite emails. With SMTP_HOST unset the invite link is logged to
# stdout instead of sent — set these to actually deliver mail in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MICD <no-reply@micd.local>

# ── Encryption (Zenodo integration) ────────────────────────────────────────────
# 32 bytes, hex-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ZENODO_TIMEOUT_MS=10000

# ── Resource limits ─────────────────────────────────────────────────────────────
# Enforced by `docker compose up` directly (no swarm required). Tune to the
# host's actual capacity.
POSTGRES_CPU_LIMIT=1
POSTGRES_MEM_LIMIT=512M
ORTHANC_CPU_LIMIT=2
ORTHANC_MEM_LIMIT=2G
BACKEND_CPU_LIMIT=2
BACKEND_MEM_LIMIT=1G

# ── Logging ───────────────────────────────────────────────────────────────────
# json-file log rotation, applied to all three services.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
