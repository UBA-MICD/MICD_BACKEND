{
  "name": "micd-backend",
  "version": "1.0.0",
  "description": "MICD API — backend for DICOM study management",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "ORTHANC_URL=http://localhost:8042 jest --testPathPatterns=integration"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dicom-parser": "^1.8.21",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/unzipper": "^0.10.11",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
