# Staging env for docker-compose.staging.yml — copy to .env.staging on the VPS
# and fill in every blank. Nothing here has an insecure default; both this
# compose file and src/config/env.ts fail fast at startup if a required secret
# is missing or left at a placeholder (NODE_ENV=production).
#
# This file (the *.example) is committed. The real .env.staging is git-ignored
# and lives ONLY on the VPS at $STAGING_VPS_PATH/backend/.env.staging.
#
# Usage on the VPS:
#   cp .env.staging.example .env.staging   # then fill in, then:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --no-build

# ── Image (set by the deploy pipeline; override to pin/rollback a SHA tag) ──────
# BACKEND_IMAGE=ghcr.io/uba-micd/micd_backend:staging

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=micd
DB_USER=micd
# Required. Generate with: openssl rand -hex 16
DB_PASSWORD=

# ── Orthanc DICOM server ──────────────────────────────────────────────────────
ORTHANC_USERNAME=orthanc
# Required. Generate with: openssl rand -hex 16
ORTHANC_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@micd.local
# Required. Generate with: openssl rand -base64 18
ADMIN_PASSWORD=
# Optional display name for the seeded admin.
ADMIN_NAME=

# ── App / invites / email ─────────────────────────────────────────────────────
# Public base URL of the staging web app (invite links are APP_BASE_URL/?invite=...).
APP_BASE_URL=https://dicomviewermed.online
# With SMTP_HOST unset, invite links are logged to stdout instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MICD <no-reply@dicomviewermed.online>

# ── Encryption (Zenodo integration) ───────────────────────────────────────────
# 32 bytes hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ZENODO_TIMEOUT_MS=10000

# ── Proxy / CORS ──────────────────────────────────────────────────────────────
# One trusted hop = the Caddy edge. Leave at 1.
TRUST_PROXY=1
# Same-origin through the edge, so leave empty (native callers send no Origin).
ALLOWED_ORIGINS=

# ── Uploads & rate limiting ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=524288000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_UPLOAD_MAX=1000
RATE_LIMIT_GLOBAL_MAX=3000

# ── Resource limits (4 GB VPS — see docs/staging-deployment/plan.md §2) ─────────
POSTGRES_MEM_LIMIT=256M
POSTGRES_MEM_RESERVE=128M
ORTHANC_MEM_LIMIT=1024M
ORTHANC_MEM_RESERVE=384M
BACKEND_MEM_LIMIT=448M
BACKEND_MEM_RESERVE=256M

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
