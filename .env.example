# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Name of the database, user, and password. Change in production.
DB_NAME=micd
DB_USER=micd
DB_PASSWORD=micd
# Host port mapped to the postgres container (change if 5432 is already in use)
DB_PORT=5432

# ── Orthanc DICOM server ──────────────────────────────────────────────────────
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc
# Host port for Orthanc REST API (change if 8042 is already in use)
ORTHANC_HTTP_PORT=8042
# Host port for DICOM C-STORE / C-FIND (change if 4242 is already in use)
ORTHANC_DICOM_PORT=4242

# ── Backend ───────────────────────────────────────────────────────────────────
# Host port exposed by the Node.js API container
BACKEND_PORT=3000

# ── Auth (TK-05) ──────────────────────────────────────────────────────────────
# Secrets that sign JWTs. MUST be changed to long random values in any real
# deployment — generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access tokens are short-lived; refresh tokens are rotated on every use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost factor for password hashing (12 = OWASP-recommended minimum)
BCRYPT_ROUNDS=12
# A shared test/development user (test@micd.local / testpassword) is seeded by
# the database migration in src/db.ts — there are no seed credentials to set here.

# ── Encryption (ZEN-01) ────────────────────────────────────────────────────────
# 32 bytes en hex. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ZENODO_TIMEOUT_MS=10000
