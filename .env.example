# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=micd
DB_USER=micd
# Required — no insecure default. Generate with e.g. `openssl rand -hex 16`.
DB_PASSWORD=
# Host port mapped to the postgres container (change if 5432 is already in use)
DB_PORT=5432

# ── Orthanc DICOM server ──────────────────────────────────────────────────────
ORTHANC_USERNAME=orthanc
# Required — no insecure default. Generate with e.g. `openssl rand -hex 16`.
ORTHANC_PASSWORD=
# Host port for Orthanc REST API (change if 8042 is already in use)
ORTHANC_HTTP_PORT=8042
# Host port for DICOM C-STORE / C-FIND (change if 4242 is already in use)
ORTHANC_DICOM_PORT=4242

# ── Backend ───────────────────────────────────────────────────────────────────
# Host port exposed by the Node.js API container
BACKEND_PORT=3000

# Interface the API binds to. Leave empty to let Node pick, which binds
# dual-stack on every interface — what the container deployment needs. Do not
# put 0.0.0.0 here: that binds IPv4 only and refuses ::1, which is what
# `localhost` resolves to first, so container healthchecks would fail.
# A desktop install running its own backend should use 127.0.0.1, so the local
# API — and the PACS behind it — is not reachable from whatever network the
# machine happens to be on.
HOST=

# How many reverse-proxy hops may set X-Forwarded-For. req.ip is derived from
# that header for every trusted hop, and the rate limiters key on req.ip, so
# each trusted hop is one a client can forge past. Use 1 behind the web repo's
# nginx; use 0 whenever the API is reached directly, including the desktop app.
TRUST_PROXY=1

# Comma-separated browser origins allowed to call this API cross-origin, e.g.
# https://micd.example,http://localhost:5173. Clients that send no Origin at
# all (the desktop app, the seeder, curl) are always allowed — CORS is a
# browser-side control. The browser client is served same-origin through nginx
# and needs no entry here. Empty means: permissive in development, native
# clients only in production.
ALLOWED_ORIGINS=

# Largest single DICOM upload accepted, in bytes (default 500 MB). Enforced
# while the request streams, so an oversized body is never buffered into RAM.
MAX_UPLOAD_BYTES=524288000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per IP, per window. The defaults suit the desktop deployment, where the whole
# app is a single user behind one loopback address doing bursty bulk work (a
# seed run uploads hundreds of DICOMs that all key to the same bucket), so the
# upload and global budgets bound abuse rather than pace normal use. Login stays
# tight because credential stuffing is the threat there.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_UPLOAD_MAX=1000
RATE_LIMIT_GLOBAL_MAX=3000

# ── TLS ───────────────────────────────────────────────────────────────────────
# Off by default (plain HTTP), e.g. for local dev or when a reverse proxy in
# front already terminates TLS. Set to exactly "true" to have the backend
# itself serve HTTPS — then TLS_CERT_PATH/TLS_KEY_PATH are required and must
# point to files readable inside the container (mount them as a volume).
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── Auth (TK-05) ──────────────────────────────────────────────────────────────
# Secrets that sign JWTs. MUST be changed to long random values in any real
# deployment — generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access tokens are short-lived; refresh tokens are rotated on every use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost factor for password hashing (12 = OWASP-recommended minimum)
BCRYPT_ROUNDS=12
# A shared test/development user (test@micd.local / testpassword) is seeded by
# the database migration — it is always a `medico`, never an admin.

# ── First admin (US-21) ───────────────────────────────────────────────────────
# Migration 006 seeds an admin ONLY when BOTH are set (otherwise the stack boots
# with no admin). The password is hashed in-database; set real values in prod.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name for the seeded admin (defaults to "Administrador").
ADMIN_NAME=

# ── Invites / email (US-H04) ──────────────────────────────────────────────────
# Public base URL of the web app; the invite link is APP_BASE_URL/?invite=<code>
# and the password reset link APP_BASE_URL/?reset=<code>.
APP_BASE_URL=http://localhost:3000
# SMTP for invite emails. Leave SMTP_HOST unset to log the invite link to stdout
# instead of sending (works for dev/CI/integration with no mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MICD <no-reply@micd.local>

# ── Encryption (ZEN-01) ───────────────────────────────────────────────────────
# 32 bytes en hex. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ZENODO_TIMEOUT_MS=10000
